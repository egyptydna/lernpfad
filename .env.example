# Local ChatGPT account connection (OAuth); disable on publicly hosted servers.
CHATGPT_LOCAL=true
# Optional alternative to the local ChatGPT account connection.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: full PostgreSQL connection string. Without it: persistent embedded PostgreSQL in DATA_DIR.
DATABASE_URL=
DATA_DIR=./.data
# Set true only when served over HTTPS (production).
COOKIE_SECURE=false
# Set your exact public origin behind an HTTPS reverse proxy, e.g. https://lernen.example.com
APP_ORIGIN=
